# Copy this file to .env and replace every placeholder before using Compose.
APP_PORT=3000
PORT=3000
CORS_ORIGIN=http://localhost:8081
JWT_ISSUER=rest-api
JWT_AUDIENCE=rest-client

MONGO_APP_DATABASE=rest_api
MONGO_APP_USERNAME=rest_api_app

SMTP_SERVICE=gmail
SMTP_USER=replace-with-smtp-user
SMTP_FROM=replace-with-sender-address

ADMIN_FIRST_NAME=Initial
ADMIN_FAMILY_NAME=Administrator
ADMIN_EMAIL=admin@example.invalid
ADMIN_TEL=replace-with-admin-phone

# Passwords and JWT material live in ./secrets; copy the .example files there.
