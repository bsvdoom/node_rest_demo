#!/usr/bin/env node

const http = require('http');
const app = require('../app');
const { connect, disconnect } = require('../models');

const port = Number(process.env.PORT || '3000');
let server;
let shuttingDown = false;

if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error('PORT must be an integer between 1 and 65535');
}

async function start() {
    await connect();
    console.log('Connected to MongoDB');

    server = http.createServer(app);
    await new Promise((resolve, reject) => {
        server.once('error', reject);
        server.listen(port, '0.0.0.0', resolve);
    });
    server.removeAllListeners('error');
    server.on('error', error => console.error('HTTP server error', error));
    console.log(`Listening on port ${port}`);
}

async function shutdown(signal) {
    if (shuttingDown) {
        return;
    }
    shuttingDown = true;
    console.log(`Received ${signal}; shutting down`);

    if (server) {
        const forceClose = setTimeout(() => server.closeAllConnections(), 10000);
        forceClose.unref();
        await new Promise(resolve => server.close(resolve));
        clearTimeout(forceClose);
    }

    await disconnect();
}

process.once('SIGTERM', () => {
    shutdown('SIGTERM').catch(error => {
        console.error('Graceful shutdown failed', error);
        process.exitCode = 1;
    });
});

process.once('SIGINT', () => {
    shutdown('SIGINT').catch(error => {
        console.error('Graceful shutdown failed', error);
        process.exitCode = 1;
    });
});

start().catch(async error => {
    console.error('Application startup failed', error);
    process.exitCode = 1;
    await disconnect().catch(disconnectError => {
        console.error('Database cleanup failed', disconnectError);
    });
});
